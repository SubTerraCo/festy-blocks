# Firebase Web SDK config for Festy Blocks
# Copy this file to `.env.local` (or `.env`) and fill in values from
# Firebase Console -> Project settings -> "Your apps" -> Web app config.
#
# All values here are considered PUBLIC (they identify the project, not
# secrets). Real security is enforced by Firestore rules + anonymous auth.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
